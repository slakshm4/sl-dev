---
// Layout.astro  ·  wraps every page: fonts, filters, nav, the persistent tooth, footer, boot script.
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Tooth from "../components/Tooth.astro";
import Footer from "../components/Footer.astro";
import CatEgg from "../components/CatEgg.astro";

const {
  title = "Shradha Lakshman · dental hygienist & health educator",
  description = "Shradha Lakshman: licensed dental hygienist, health professions educator, and curious human. portfolio, cv, and a few odd hobbies.",
  page = "",
} = Astro.props;
// absolute urls for link previews (imessage, email, teams, slack…): they can't read relative paths
const origin = (Astro.site ?? new URL("https://www.shradhalakshman.com")).origin;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const preview = `${origin}/tooth-preview.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ddd7ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shradha Lakshman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="a little tooth logo and the name shradha lakshman" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- fonts are served from this site (see styles/fonts.css). the four files the first screen needs are fetched right away. -->
    <link rel="preload" href="/fonts/bodoni-moda-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/bodoni-moda-latin-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/reenie-beanie-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // "lite" = phones and tablets (coarse pointer). they skip the page-transition snapshots, the grain blend and the endless
        // decorative loops: iOS Safari struggles with those. see the .lite rules in global.css.
        var lite = false;
        try { lite = matchMedia("(pointer: coarse)").matches; } catch (e) {}
        if (lite) { try { document.startViewTransition = undefined; } catch (e) {} }
        function apply() {
          var t = "light", m = "on", a = "off";
          try {
            t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            m = localStorage.getItem("motion") || (matchMedia("(prefers-reduced-motion: reduce)").matches ? "off" : "on");
            a = localStorage.getItem("a11y") === "on" ? "on" : "off";
          } catch (e) {}
          d.setAttribute("data-theme", t);
          d.setAttribute("data-motion", a === "on" ? "off" : m);
          d.setAttribute("data-a11y", a);
          d.classList.add("js");
          if (lite) d.classList.add("lite");
        }
        apply();
        if (location.pathname === "/" || location.pathname === "/index.html") d.style.setProperty("--p", "0");
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">skip to content</a>
    <!-- screen readers hear changes made by the accessible-mode button through this -->
    <div id="a11y-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

    <!-- svg filters that make paper edges torn and ink a little wobbly -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="rip" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="5" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="12" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="rip-fine" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.075" numOctaves="3" seed="9" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="stamp-rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.8" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="ink-wobble" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="11" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <!-- stop-motion "line boil" for the quivering sprites: three slightly different wobbles, swapped by css -->
        <filter id="boil-1" x="-8%" y="-8%" width="116%" height="116%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="3" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" /></filter>
        <filter id="boil-2" x="-8%" y="-8%" width="116%" height="116%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="14" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" /></filter>
        <filter id="boil-3" x="-8%" y="-8%" width="116%" height="116%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="1" seed="27" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" /></filter>
        <!-- loose marker scribbles used to colour the sprites that draw themselves in -->
        <pattern id="hatch-ink" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:var(--ink)" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-peri" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#8e9bde" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-butter" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#e9c34e" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-blush" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#ec8fb0" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-fish" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#ee8f3f" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-ice" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#9db4d6" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-sage" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#7fb07e" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-brown" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#8a7a55" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
        <pattern id="hatch-sand" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-32)"><path d="M-1 1L8 2.4L-1 4.2L8 5.8" fill="none" style="stroke:#d8b27a" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" /></pattern>
      </defs>
    </svg>
    <div class="grain" aria-hidden="true"></div>

    <Nav />
    <Tooth />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <CatEgg />

    <script>
      import { boot } from "../scripts/boot";
      boot();
    </script>
  </body>
</html>
