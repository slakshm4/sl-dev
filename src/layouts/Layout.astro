---
import Nav from "../components/Nav.astro";
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <style>

    body {
      margin: 0;
      background: #d9d9d9;
      overflow-x: hidden;
    }

    .hero-video {
      position: absolute;
      inset: 0;
      z-index: -5;
    }

    .hero-video video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

  </style>
</head>

<body>

  <Nav />

  <div class="hero-video">
    <video autoplay muted loop playsinline>
      <source src="/background.mp4" type="video/mp4" />
    </video>
  </div>

  <slot />

</body>
</html>