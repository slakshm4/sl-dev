---
// Layout.astro  ·  wraps every page: fonts, filters, nav, the persistent tooth, footer, boot script.
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Tooth from "../components/Tooth.astro";
import Footer from "../components/Footer.astro";
import CatEgg from "../components/CatEgg.astro";

const {
  title = "Shradha Lakshman · dental hygienist & health educator",
  description = "Shradha Lakshman: licensed dental hygienist, health professions educator, and curious human. portfolio, cv, and a few odd hobbies.",
  page = "",
} = Astro.props;
// absolute urls for link previews (imessage, email, teams, slack…): they can't read relative paths
const origin = (Astro.site ?? new URL("https://www.shradhalakshman.com")).origin;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const preview = `${origin}/tooth-preview.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ddd7ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shradha Lakshman" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="a little tooth logo and the name shradha lakshman" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Reenie+Beanie&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // "lite" = phones and tablets (coarse pointer). they skip the page-transition snapshots, the grain blend and the endless
        // decorative loops: iOS Safari struggles with those. see the .lite rules in global.css.
        var lite = false;
        try { lite = matchMedia("(pointer: coarse)").matches; } catch (e) {}
        if (lite) { try { document.startViewTransition = undefined; } catch (e) {} }
        function apply() {
          var t = "light", m = "on";
          try {
            t = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            m = localStorage.getItem("motion") || (matchMedia("(prefers-reduced-motion: reduce)").matches ? "off" : "on");
          } catch (e) {}
          d.setAttribute("data-theme", t);
          d.setAttribute("data-motion", m);
          d.classList.add("js");
          if (lite) d.classList.add("lite");
        }
        apply();
        if (location.pathname === "/" || location.pathname === "/index.html") d.style.setProperty("--p", "0");
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">skip to content</a>

    <!-- svg filters that make paper edges torn and ink a little wobbly -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="rip" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="5" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="12" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="rip-fine" x="-6%" y="-12%" width="112%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.075" numOctaves="3" seed="9" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="stamp-rough" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="1.8" xChannelSelector="R" yChannelSelector="G" />
        </filter>
        <filter id="ink-wobble" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="11" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <div class="grain" aria-hidden="true"></div>

    <Nav />
    <Tooth />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <CatEgg />

    <script>
      import { boot } from "../scripts/boot";
      boot();
    </script>
  </body>
</html>
