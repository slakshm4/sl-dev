---
// Nav.astro  ·  your original nav, grown up: same six links, same shimmer-on-hover (now a sweep of colour
// through the word, because a white sheen disappears on paper), and the word gets slightly bigger.
// the tooth sits in the gap in the middle (it's <Tooth />, fixed, persistent across pages).
import HandArrow from "./HandArrow.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const left = [
  { label: "home", href: "/" },
  { label: "north star", href: "/north-star" },
  { label: "explore", href: "/explore" },
];
const right = [
  { label: "experience", href: "/experience" },
  { label: "notebook", href: "/notebook" },
  { label: "say hi!", href: "/say-hi" },
];
const current = (href) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---
<header class="nav-bar">
  <div class="nav-paper" aria-hidden="true"></div>
  <!-- the docked tooth is a picture floating above the nav (it can't take clicks), so this invisible link sits right under it: tap the tooth, go home. the "home" word in the nav is the keyboard / screen-reader route. -->
  <a class="tooth-link" href="/" tabindex="-1" aria-hidden="true"></a>

  <!-- accessible mode: first in the tab order (right after the skip link); sits on the left so the round tools on the right keep their room -->
  <button class="a11y-btn" type="button" data-toggle="a11y" aria-pressed="false" aria-label="accessible mode" aria-describedby="a11y-note-text" title="switch to accessible mode: easier-to-read font, no animation, plainer backgrounds, higher contrast">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="7.2" r="1.7" fill="currentColor"/><path d="M6.4 10.2l5.6.9 5.6-.9M12 11.2v3.6M12 14.8l-2.6 4.4M12 14.8l2.6 4.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span class="a11y-btn-label">accessible mode</span>
  </button>

  <nav class="nav" id="site-nav" aria-label="main">
    <ul class="nav-group">
      {left.map((l) => (
        <li><a class="nav-item" href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <span class="nav-gap" aria-hidden="true"></span>
    <ul class="nav-group">
      {right.map((l) => (
        <li><a class="nav-item" href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="nav-tools">
    <button class="tool" type="button" data-toggle="theme" aria-pressed="false" aria-label="dark mode">
      <svg class="tool-sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="tool-moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>
    <button class="tool" type="button" data-toggle="motion" aria-pressed="false" aria-label="pause animations">
      <svg class="tool-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      <svg class="tool-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8 5l11 7-11 7Z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg>
    </button>
    <button class="tool tool--menu" type="button" data-toggle="menu" aria-expanded="false" aria-controls="site-nav" aria-label="open menu">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<!-- a handwritten note under the accessibility button. it scrolls away with the page (not fixed). screen readers hear it as the button's description instead of as loose text on every page. -->
<aside class="a11y-note" aria-hidden="true" data-no-gloss>
  <HandArrow shape="arc" size={46} class="a11y-note-arrow" />
  <p class="a11y-note-p" id="a11y-note-text">this site is mostly WCAG AA <span style="white-space:nowrap">compliant—</span> click the button for the OpenDyslexic font and screen-reader legibility. alt text is also available!</p>
</aside>

<style is:global>
  .nav-bar { position: fixed; inset: 0 0 auto 0; z-index: 100; height: var(--header-h); }
  /* torn strip of paper along the top of the page */
  .nav-paper { position: absolute; inset: 0; pointer-events: none; filter: drop-shadow(0 3px 0 var(--shadow)); }
  .nav-paper::before { content: ""; position: absolute; inset: -30px -30px -5px -30px; background: var(--chalk); filter: url(#rip); }
  .nav-paper::after  { content: ""; position: absolute; inset: -30px -30px 0 -30px; background: var(--paper); filter: url(#rip-fine); }

  .tooth-link { position: absolute; z-index: 2; top: 0; left: 50%; width: 64px; height: var(--header-h); transform: translateX(-50%); -webkit-tap-highlight-color: transparent; }
  /* the tooth gives a little wiggle when the pointer is over it */
  .tooth-3d { transition: transform 0.35s cubic-bezier(0.34, 1.7, 0.5, 1); }
  @media (hover: hover) { :root:has(.tooth-link:hover) .tooth-3d { transform: rotate(-7deg) scale(1.12); } }
  .nav { position: relative; z-index: 1; height: 100%; display: flex; align-items: center; justify-content: center; gap: clamp(0.75rem, 2.4vw, 2.6rem); padding-inline: 0.5rem; }
  .nav-group { list-style: none; display: flex; align-items: center; gap: clamp(1rem, 2.6vw, 2.6rem); margin: 0; padding: 0; }
  .nav-gap { width: clamp(70px, 8vw, 110px); }

  .nav-item {
    position: relative; display: inline-block; padding: 0.3rem 0.1rem; white-space: nowrap;
    font: italic 500 clamp(1.1rem, 1.7vw, 1.45rem) / 1 var(--f-display); letter-spacing: -0.01em;
    color: var(--ink); text-decoration: none; will-change: transform;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), text-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-item:hover, .nav-item:focus-visible {
    transform: translateY(-2px) scale(1.12);
    text-shadow: 0 5px 10px rgba(31, 27, 46, 0.14);
    background: linear-gradient(105deg, var(--ink) 36%, var(--peri-deep) 44%, var(--blush) 50%, var(--peri-deep) 56%, var(--ink) 64%) 100% 0 / 300% 100%;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    animation: nav-shimmer 0.85s ease forwards;
  }
  @keyframes nav-shimmer { to { background-position: 0 0; } }
  .nav-item[aria-current="page"] { font-weight: 700; }
  .nav-item[aria-current="page"]::before {
    content: ""; position: absolute; left: -0.95rem; top: 50%; width: 0.8rem; height: 0.8rem; margin-top: -0.45rem;
    background: var(--ink); -webkit-mask: var(--star-mask) center / contain no-repeat; mask: var(--star-mask) center / contain no-repeat;
  }

  .a11y-btn {
    position: absolute; z-index: 2; left: var(--gutter); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 0.5rem; height: 44px; min-width: 44px; padding: 0; justify-content: center;
    background: var(--paper); color: var(--ink); border: 2px solid var(--ink); border-radius: 99px;
    font: 500 1rem/1 var(--f-body); white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s;
  }
  .a11y-btn:hover { transform: translateY(-50%) rotate(-4deg) scale(1.05); }
  .a11y-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .a11y-btn-label { display: none; }
  /* wide screens have room for the words */
  @media (min-width: 1680px) { .a11y-btn { padding: 0 1rem 0 0.7rem; } .a11y-btn-label { display: inline; } }
  @media (max-width: 880px) { .a11y-btn { left: 0.75rem; } }

  /* the note under the accessibility button: a line of handwriting in a strip the page makes room for (see --note-h), so it never covers content. it scrolls away with the page. */
  :root { --note-h: 4.3rem; }
  .a11y-note {
    position: absolute; z-index: 90; top: calc(var(--header-h) + 0.7rem); left: calc(var(--gutter) + 0.35rem); right: var(--gutter);
    max-width: 33rem; display: flex; align-items: flex-start; gap: 0.5rem; pointer-events: none;
    transform: rotate(-0.8deg); transform-origin: top left;
  }
  .a11y-note-arrow { flex: none; transform: rotate(180deg); margin-top: -0.4rem; }
  .a11y-note-p { margin: 0.5rem 0 0; font: 400 1.5rem/1.05 var(--f-hand); color: var(--ink); letter-spacing: 0.01em; }
  /* wide screens: the button grows a label, so push the arrow under the middle of it */
  @media (min-width: 1680px) { .a11y-note { left: calc(var(--gutter) + 3.4rem); } }
  /* phones and small tablets: the words wrap onto a few lines */
  @media (max-width: 880px) { :root { --note-h: 4.9rem; } .a11y-note { left: 1.1rem; right: 1rem; } .a11y-note-p { font-size: 1.3rem; } }
  @media print { .a11y-note { display: none; } }
  /* in accessible mode the motion switch is pointless (everything is already still) */
  :root[data-a11y="on"] .tool[data-toggle="motion"] { display: none; }
  .nav-tools { position: absolute; z-index: 2; right: var(--gutter); top: 50%; transform: translateY(-50%); display: flex; gap: 0.4rem; }
  .tool {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    background: var(--paper); color: var(--ink); border: 2px solid var(--ink); border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tool:hover { transform: rotate(-12deg) scale(1.08); }
  .tool--menu { display: none; }
  .tool-moon, .tool-play { display: none; }
  :root[data-theme="dark"] .tool-sun { display: none; }
  :root[data-theme="dark"] .tool-moon { display: block; }
  :root[data-motion="off"] .tool-pause { display: none; }
  :root[data-motion="off"] .tool-play { display: block; }

  /* very small phones: slimmer buttons so the docked tooth never sits on top of one */
  @media (max-width: 380px) {
    .tool { width: 38px; height: 38px; }
    .tool svg { width: 20px; height: 20px; }
    .nav-tools { gap: 0.25rem; right: 0.5rem; }
    .a11y-btn { height: 38px; min-width: 38px; left: 0.5rem; }
  }
  @media (max-width: 880px) {
    .tool--menu { display: grid; }
    .nav-tools { right: 0.75rem; }
    .nav {
      position: fixed; inset: var(--header-h) 0 auto 0; height: auto; display: none; flex-direction: column;
      padding: 1.25rem var(--gutter) 1.75rem; background: var(--paper); gap: 0;
      border-bottom: 3px solid var(--ink); box-shadow: 0 8px 0 var(--shadow);
    }
    body.menu-open .nav { display: flex; }
    .nav-gap { display: none; }
    .nav-group { flex-direction: column; align-items: flex-start; gap: 0.25rem; width: 100%; }
    .nav-item { font-size: 1.9rem; padding: 0.45rem 0.2rem; }
    .nav-item[aria-current="page"]::before { left: -1.2rem; width: 1rem; height: 1rem; }
  }
</style>
