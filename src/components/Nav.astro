<style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap');

.nav {
  position: absolute;

  top: 42px;

  /* OFFSET RIGHT FOR SPINE BALANCE */
  left: 56%;
  transform: translateX(-50%);

  display: flex;
  gap: 42px;

  z-index: 1000;
}

/* NAV LINKS */
.nav-item {
  position: relative;

  font-family: 'Oswald', sans-serif;
  font-size: 40px;
  font-weight: 700;

  letter-spacing: 0.02em;

  color: #a2cba1;

  text-decoration: none;

  display: inline-block;

  will-change: transform;

  transition:
    transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
    text-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.3s ease,
    filter 0.45s ease;
}

/* HOVER */
.nav-item:hover {

  transform: translateY(-2px);

  text-shadow:
    0 6px 14px rgba(0, 0, 0, 0.18),
    0 0 10px rgba(255, 255, 255, 0.09),
    0 0 18px rgba(162, 203, 161, 0.08);

  filter: brightness(1.06);

  opacity: 0.99;
}

/* SHIMMER */
.nav-item::after {
  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 18%;
  height: 100%;

  background: linear-gradient(
    120deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,0.22) 50%,
    rgba(255,255,255,0) 100%
  );

  transform: skewX(-18deg);

  opacity: 0;

  pointer-events: none;
}

/* ONLY ACTIVATE ON HOVER */
.nav-item:hover::after {
  opacity: 1;
  animation: shimmer 0.75s ease;
}

@keyframes shimmer {

  0% {
    left: -120%;
  }

  100% {
    left: 170%;
  }
}
</style>

<nav class="nav">

  <a class="nav-item" href="/">
    home
  </a>

  <a class="nav-item" href="/north-star">
    north star
  </a>

  <a class="nav-item" href="/explore">
    explore
  </a>

  <a class="nav-item" href="/experience">
    experience
  </a>

  <a class="nav-item" href="/notebook">
    notebook
  </a>

  <a class="nav-item" href="/say-hi">
    say hi!
  </a>

</nav>