---
// PostLinks.astro  ·  little pills that open a post from the UBC e-portfolio in a new tab.
// <PostLinks keys={["decolonizing-success"]} />   (the keys live in src/data/eportfolio.ts)
import { getPost } from "../data/eportfolio";
const { keys = [], class: klass = "" } = Astro.props;
const items = keys.map((k) => getPost(k)).filter(Boolean);
---
{items.length > 0 && (
  <ul class={`posts ${klass}`} aria-label="related e-portfolio posts">
    {items.map((x) => (
      <li>
        <a class="post" href={x.href} target="_blank" rel="noopener">
          <span class="post-k keep-case">e-portfolio</span>
          <span class="post-t keep-case">{x.label}</span>
          <svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style is:global>
  .posts { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; margin: 0.7rem 0 0; padding: 0; }
  .post {
    --post-ink: var(--ink); --post-bg: var(--peri-pale);
    display: inline-flex; align-items: flex-start; gap: 0.5rem; max-width: 100%; padding: 0.32rem 0.7rem 0.36rem 0.4rem;
    color: var(--post-ink); background: var(--post-bg); border: 2px solid var(--post-ink); border-radius: 18px;
    font: 500 0.95rem/1.25 var(--f-body); text-decoration: none; box-shadow: 2px 2px 0 var(--post-ink);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s, background-color 0.2s;
  }
  .post:hover, .post:focus-visible { transform: translate(-1px, -2px) rotate(-1deg); box-shadow: 4px 4px 0 var(--post-ink); background: var(--butter); color: #1f1b2e; border-color: #1f1b2e; }
  /* the cv page styles every span / ul / li inside its lists: these (more specific) rules keep the pills looking the same everywhere */
  .posts.posts { display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; }
  .posts.posts > li { min-width: 0; max-width: 100%; padding: 0; border: 0; font-size: inherit; line-height: inherit; }
  .post .post-k, .post .post-t { display: inline; font-style: normal; }
  .post .post-t { font-size: 0.92rem; line-height: 1.3; color: inherit; padding-top: 0.05em; }
  .post .post-k { display: inline-block; flex: none; margin-top: 0.1em; padding: 0.22em 0.55em 0.26em; font: 400 0.7rem/1 var(--f-type); letter-spacing: 0.05em; color: var(--post-bg); background: var(--post-ink); border-radius: 99px; }
  .post:hover .post-k, .post:focus-visible .post-k { color: var(--butter); background: #1f1b2e; }
  .post-t { min-width: 0; overflow-wrap: anywhere; }
  .post svg { flex: none; margin-top: 0.2em; transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .post:hover svg, .post:focus-visible svg { transform: translate(2px, -2px); }
  /* on the always-cream cards and sheets the colours stay dark in dark mode too */
  .fn-in .post, .pc-plate .post { --post-ink: #1f1b2e; --post-bg: #cbd2f3; }
</style>
