---
// Clip.astro  ·  desk hardware: a paper clip or a black binder clip, drawn like the stickers (ink outline). decorative only.
// <Clip kind="paper" size={34} />   ·   <Clip kind="binder" size={46} />
const { kind = "paper", size = 34, class: klass = "", style = "" } = Astro.props;
---
{kind === "binder" ? (
  <svg class={`clip clip--binder ${klass}`} viewBox="0 0 64 60" width={size} height={size * 0.94} aria-hidden="true" focusable="false" style={style}>
    <path d="M13 28C11 6 53 6 51 28" fill="none" stroke="#1f1b2e" stroke-width="3.2" stroke-linecap="round" />
    <path d="M17 28C16 12 48 12 47 28" fill="none" stroke="#c9cbe0" stroke-width="2" stroke-linecap="round" />
    <path d="M5 26L59 26L52 56L12 56Z" fill="#2b2540" stroke="#1f1b2e" stroke-width="2.4" stroke-linejoin="round" />
    <path d="M12 32L52 32" stroke="#6b6590" stroke-width="2" stroke-linecap="round" opacity=".7" />
  </svg>
) : (
  <svg class={`clip clip--paper ${klass}`} viewBox="0 0 32 72" width={size} height={size * 2.25} aria-hidden="true" focusable="false" style={style}>
    <path d="M11 20V54a7 7 0 0 0 14 0V14a10 10 0 0 0 -20 0V50a14 14 0 0 0 28 0V22" fill="none" stroke="#1f1b2e" stroke-width="5.4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M11 20V54a7 7 0 0 0 14 0V14a10 10 0 0 0 -20 0V50a14 14 0 0 0 28 0V22" fill="none" stroke="#d5d9ee" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}

<style is:global>
  .clip { display: block; overflow: visible; filter: drop-shadow(1.5px 2px 0 rgba(31, 27, 46, 0.28)); }
</style>
