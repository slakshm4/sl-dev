---
// Blocks.astro  ·  turns a list of strings (the mini-markup from src/lib/text.ts) into headings, paragraphs, pull quotes,
// lists, pictures and arrow call-outs. used for pieces of writing and for project write-ups.
import { toBlocks } from "../lib/text";
import HandArrow from "./HandArrow.astro";
const { items = [], marks = false } = Astro.props;
const blocks = toBlocks(items);
---
{blocks.map((b) => {
  if (b.t === "h2") return <h2 class="blk-h" set:html={b.html} />;
  if (b.t === "h3") return <h3 class="blk-h3" set:html={b.html} />;
  if (b.t === "quote") return <blockquote class="blk-quote"><p set:html={b.html} /></blockquote>;
  if (b.t === "cta") return (
    <div class="blk-cta">
      <HandArrow shape="wave" size={76} class="blk-cta-arrow" />
      <p class="blk-cta-t hand" set:html={b.html} />
    </div>
  );
  if (b.t === "ul") return <ul class="blk-list">{b.items.map((x) => <li set:html={x} />)}</ul>;
  if (b.t === "ol") return <ol class="blk-list">{b.items.map((x) => <li set:html={x} />)}</ol>;
  if (b.t === "img") return (
    <figure class="blk-fig">
      <a class="blk-fig-in" href={b.src} target="_blank" rel="noopener">
        <img src={b.src} alt={b.alt} loading="lazy" decoding="async" />
        <span class="sr-only"> (open the full-size picture in a new tab)</span>
      </a>
      {b.cap && <figcaption set:html={b.cap} />}
    </figure>
  );
  return <p class="blk-p" set:html={b.html} />;
})}

<style is:global>
  .blk-h { margin: 2.6rem 0 0.7rem; font: italic 600 clamp(1.5rem, 3.4vw, 1.95rem)/1.15 var(--f-display); letter-spacing: -0.01em; }
  .blk-h > :first-child, .blk-h { background: linear-gradient(transparent 64%, rgba(244, 215, 119, 0.65) 64% 92%, transparent 92%) no-repeat 0 0 / 100% 100%; display: inline; padding: 0 0.15em 0 0; }
  .blk-h3 { margin: 1.8rem 0 0.4rem; font: 600 1.25rem/1.2 var(--f-display); }
  .blk-p { margin: 0; }
  .blk-quote { margin: 2rem 0; padding: 0.3rem 0 0.3rem 1.3rem; border-left: 4px solid var(--peri); }
  .blk-quote p { margin: 0; font: italic 500 clamp(1.3rem, 3vw, 1.6rem)/1.35 var(--f-display); }
  .blk-list { margin: 0.9rem 0 0.9rem 1.5rem; padding: 0; }
  .blk-list li { margin: 0.55rem 0; padding-left: 0.3rem; }
  /* a hand-drawn arrow pointing down at a line of handwriting (and the link that ends it) */
  .blk-cta { margin: 1.5rem 0 0.3rem; }
  .blk-cta-arrow { display: block; margin: 0 0 -0.35rem 1.4rem; }
  .blk-cta .blk-cta-t { margin: 0; font-size: clamp(1.75rem, 4.6vw, 2.3rem); line-height: 1.12; transform: rotate(-1deg); transform-origin: 0 50%; overflow-wrap: break-word; }
  .blk-cta .blk-cta-t a { color: #3c4a9e; text-decoration: underline wavy #4a58ab; text-decoration-thickness: 2px; text-underline-offset: 0.2em; display: inline-block; }
  .blk-cta .blk-cta-t a:hover, .blk-cta .blk-cta-t a:focus-visible { background: rgba(244, 215, 119, 0.7); }
  /* footnote numbers: a little tab raised above the word */
  .fnref { margin-left: 0.08em; font: 600 0.68em/1 var(--f-type); vertical-align: baseline; position: relative; top: -0.7em; }
  .fnref + .fnref { margin-left: 0.2em; }
  .fnref a { position: relative; padding: 0.22em 0.38em; text-decoration: none; color: #3c4a9e; background: rgba(182, 192, 246, 0.55); border-radius: 3px; }
  .fnref a::after { content: ""; position: absolute; inset: -0.7em -0.4em; }
  .fnref a:hover, .fnref a:focus-visible { background: #4a58ab; color: #fffdf3; }
  .blk-fig { margin: 2.2rem 0; text-align: center; }
  .blk-fig-in { display: inline-block; max-width: 100%; padding: 0.55rem 0.55rem 0.4rem; background: #fffdf3; border: 2px solid #1f1b2e; box-shadow: 5px 6px 0 var(--shadow); transform: rotate(-0.8deg); }
  .blk-fig:nth-of-type(even) .blk-fig-in { transform: rotate(0.9deg); }
  .blk-fig img { display: block; max-width: 100%; max-height: min(78vh, 46rem); width: auto; height: auto; margin: 0 auto; border: 1.5px solid #1f1b2e; }
  .blk-fig figcaption { margin: 0.75rem auto 0; max-width: 34rem; font: 400 0.82rem/1.4 var(--f-type); color: #4c4666; text-align: center; }
</style>
