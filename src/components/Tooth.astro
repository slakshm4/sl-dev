---
// Tooth.astro  ·  tooth no. 26 (fdi): permanent upper left first molar, side view, with the cusp of carabelli.
// built as a stack of cut-paper layers in real css 3d so it can turn slowly like a little paper diorama.
// it is fixed + persistent: big in the hero, then it scrolls up and docks in the middle of the nav on every page.
// (to use a real 3d model later: replace .tooth-3d with <model-viewer src="/tooth-26.glb" auto-rotate>.)

const ink = "#1f1b2e";

// crown, roots and the back (lingual) row of cusps. all drawn in a 220 x 220 box.
const crown =
  "M40 64C36 42 50 26 70 26C86 26 98 36 106 50C109 56 114 56 117 50C126 36 138 26 154 26C174 26 186 44 180 66C177 82 172 98 162 110C158 115 152 117 146 117L74 117C68 117 62 115 58 110C48 98 42 82 40 64Z";
const back = "M52 72C45 46 54 18 76 16C91 14 99 26 103 38C109 26 122 14 140 14C164 14 178 40 170 72Z";
const rootMB = "M56 108C50 136 42 166 50 196C53 208 66 210 70 198C78 170 92 140 100 112Z";
const rootDB = "M120 112C130 140 146 168 152 196C155 208 168 208 170 196C176 166 172 134 164 106Z";
const rootP = "M80 106C82 146 94 180 102 208C105 218 120 218 122 208C130 178 138 142 140 106Z";
const tape = "M30 100L192 97L188 102L192 108L188 113L192 119L30 122L34 116L30 111L34 105Z";
---
<div class="tooth-wrap" aria-hidden="true" transition:persist="tooth">
  <div class="tooth-3d">
    <div class="tooth-shadow"></div>
    <div class="tooth-tilt">
      <div class="tooth-turn">
        <div class="tooth-stack">
          <!-- palatal root, furthest back -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:-26px">
            <path d={rootP} fill="#d4c598" stroke={ink} stroke-width="3.2" stroke-linejoin="round" />
            <path d="M110 128C110 156 108 180 110 204" fill="none" stroke={ink} stroke-width="2" stroke-linecap="round" opacity=".28" />
          </svg>
          <!-- back row of cusps + the cusp of carabelli -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:-14px">
            <path d={back} fill="#eadfbd" stroke={ink} stroke-width="3.2" stroke-linejoin="round" />
            <ellipse class="t-carabelli" cx="36" cy="54" rx="15" ry="12" transform="rotate(-24 36 54)" fill="#f4d777" stroke={ink} stroke-width="3.2" />
            <path d="M28 50Q34 44 42 47" fill="none" stroke="#fff6d6" stroke-width="2.6" stroke-linecap="round" />
          </svg>
          <!-- the two visible roots -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:-4px">
            <path d={rootMB} fill="#e6d9b4" stroke={ink} stroke-width="3.2" stroke-linejoin="round" />
            <path d={rootDB} fill="#e6d9b4" stroke={ink} stroke-width="3.2" stroke-linejoin="round" />
            <g fill="none" stroke={ink} stroke-width="2" stroke-linecap="round" opacity=".28">
              <path d="M70 128C64 152 60 172 62 192" />
              <path d="M150 126C156 150 160 170 160 190" />
            </g>
          </svg>
          <!-- the crown -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:8px">
            <path d={crown} fill="#fbf7e8" stroke={ink} stroke-width="3.4" stroke-linejoin="round" />
            <g fill="none" stroke={ink} stroke-width="2.2" stroke-linecap="round" opacity=".6">
              <path d="M112 58C108 74 116 90 112 104" />
              <path d="M66 52C70 66 78 76 90 80" />
              <path d="M158 52C154 66 146 76 134 80" />
            </g>
          </svg>
          <!-- highlights -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:18px">
            <path d="M58 56C57 44 64 36 74 35" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" />
            <path d="M165 60C166 50 162 44 157 40" fill="none" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity=".9" />
            <ellipse cx="86" cy="64" rx="9" ry="5" transform="rotate(-24 86 64)" fill="#ffffff" opacity=".8" />
          </svg>
          <!-- a strip of floral washi tape where the gum line would be -->
          <svg class="t-layer" viewBox="0 0 220 220" style="--z:28px">
            <defs>
              <pattern id="t-flowers" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(-8)">
                <rect width="22" height="22" fill="#8d9be0" />
                <g fill="#fffdf3">
                  <circle cx="6" cy="6" r="2.1" /><circle cx="6" cy="2.6" r="1.7" /><circle cx="6" cy="9.4" r="1.7" /><circle cx="2.6" cy="6" r="1.7" /><circle cx="9.4" cy="6" r="1.7" />
                  <circle cx="17" cy="17" r="2.1" /><circle cx="17" cy="13.6" r="1.7" /><circle cx="17" cy="20.4" r="1.7" /><circle cx="13.6" cy="17" r="1.7" /><circle cx="20.4" cy="17" r="1.7" />
                </g>
                <g fill="#f2b1c6"><circle cx="6" cy="6" r="1" /><circle cx="17" cy="17" r="1" /></g>
              </pattern>
            </defs>
            <path d={tape} fill="url(#t-flowers)" stroke={ink} stroke-width="3" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* big in the hero (--p: 0) → docked in the nav (--p: 1). --p is set on <html> by boot.ts */
  :root { --p: 1; --tw: clamp(250px, min(46vw, 54svh), 500px); }
  .tooth-wrap {
    position: fixed; z-index: 110; top: 2px; left: 50%; width: var(--tw); height: var(--tw);
    pointer-events: none; transform-origin: 50% 0;
    --y0: max(1.5rem, calc((100svh - var(--tw)) / 2 - 2.25rem));
    transform: translate(-50%, calc((1 - var(--p)) * var(--y0))) scale(calc(1 - 0.82 * var(--p)));
    will-change: transform;
  }
  .tooth-3d { position: relative; width: 100%; height: 100%; perspective: 1100px; }
  .tooth-tilt { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(-7deg); }
  .tooth-turn { position: absolute; inset: 0; transform-style: preserve-3d; animation: tooth-turn 15s cubic-bezier(0.55, 0, 0.3, 1) infinite; }
  .tooth-stack { position: absolute; inset: 0; transform-style: preserve-3d; }
  .t-layer { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transform: translateZ(var(--z)); backface-visibility: visible; }
  /* rests facing front for a few seconds, then takes one slow full turn */
  @keyframes tooth-turn { 0%, 24% { transform: rotateY(-14deg); } 100% { transform: rotateY(346deg); } }
  .tooth-shadow {
    position: absolute; left: 22%; right: 22%; bottom: 0; height: 9%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(31, 27, 46, 0.34), transparent); filter: blur(5px);
    opacity: calc(1 - var(--p) * 1.4);
  }
  :root[data-motion="off"] .tooth-turn { animation: none; transform: rotateY(-14deg); }
  @media (prefers-reduced-motion: reduce) { :root:not([data-motion="on"]) .tooth-turn { animation: none; transform: rotateY(-14deg); } }
</style>
