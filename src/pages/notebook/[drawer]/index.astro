---
// notebook/[drawer]/index.astro  ·  one drawer of the words section: a grid of boxes, one per piece.
// the drawers and their pieces live in src/data/writing.ts (and prose.ts, poems.ts). case studies, ephemera and trials
// don't get a drawer page: their cards live on the notebook page and open the pieces directly.
import Layout from "../../../layouts/Layout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import HandArrow from "../../../components/HandArrow.astro";
import WriteCard from "../../../components/WriteCard.astro";
import { writing, shown, pieceHref } from "../../../data/writing";

export function getStaticPaths() {
  return writing.filter((d) => !d.tab).map((drawer, i) => ({ params: { drawer: drawer.slug }, props: { drawer, i } }));
}
const { drawer, i } = Astro.props;
const list = shown(drawer);
---
<Layout page="notebook" title={`${drawer.title} · notebook · Shradha Lakshman`} description={drawer.sub}>
  <div class="wrap page-section wl">
    <p class="wl-back"><a href="/notebook#words"><svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M21 12H4M11 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg> back to the notebook</a></p>
    <SectionTitle text={drawer.title} as="h1" start={i + 2} />
    <p class="hand wl-sub">{drawer.sub} <HandArrow shape="arc" size={46} /></p>
    {drawer.intro && <p class="wl-intro">{drawer.intro}</p>}

    <ul class={`wl-grid wl-grid--${drawer.style}`} role="list">
      {list.map((p, n) => <WriteCard drawer={drawer} piece={p} n={n} i={i} href={pieceHref(drawer, p)} />)}
      <li class="wlc-ghost" aria-hidden="true">
        <span class="hand">the next one is still on the desk.</span>
      </li>
    </ul>
  </div>
</Layout>

<style is:global>
  .wl-back { margin: 0 0 1.4rem; font-size: 1.05rem; }
  .wl-back a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); text-underline-offset: 0.25em; }
  .wl-sub { margin: -0.4rem 0 0.4rem 0.4rem; display: flex; align-items: flex-end; gap: 0.3rem; font-size: 1.7rem; color: var(--ink-soft); }
  .wl-intro { max-width: 52ch; margin: 0.6rem 0 0 0.4rem; font-size: 1.15rem; line-height: 1.55; }
  .wlc-ghost { display: grid; place-items: center; min-height: 12rem; padding: 1rem; border: 2.5px dashed color-mix(in srgb, var(--ink) 40%, transparent); border-radius: 6px; color: var(--ink-soft); font-size: 1.6rem; text-align: center; transform: rotate(1deg); }
</style>
