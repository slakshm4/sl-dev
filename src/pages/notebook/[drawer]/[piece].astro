---
// notebook/[drawer]/[piece].astro  ·  one piece of writing, set on its own paper with a few stickers.
// the words live in src/data (writing.ts, prose.ts, poems.ts, articles.ts). the layout adapts to the drawer's `style`:
// prose · marginalia · scraps · verse · lyrics. anthologies show their pieces as cards; stereo poems show both ears.
import Layout from "../../../layouts/Layout.astro";
import SectionTitle from "../../../components/SectionTitle.astro";
import Sticker from "../../../components/Sticker.astro";
import Blocks from "../../../components/Blocks.astro";
import WriteCard from "../../../components/WriteCard.astro";
import StereoPoem from "../../../components/StereoPoem.astro";
import { writing, shown, pieceHref } from "../../../data/writing";
import { inline, plain, readTime, toBlocks } from "../../../lib/text";

export function getStaticPaths() {
  const out = [];
  writing.forEach((drawer, di) => {
    const find = (slug) => drawer.pieces.find((x) => x.slug === slug);
    drawer.pieces.forEach((piece) => {
      const anthology = piece.partOf ? find(piece.partOf) : undefined;
      const parts = (piece.parts ?? []).map(find).filter(Boolean);
      const list = anthology ? anthology.parts.map(find).filter(Boolean) : shown(drawer);
      const pi = list.findIndex((x) => x.slug === piece.slug);
      out.push({
        params: { drawer: drawer.slug, piece: piece.slug },
        props: { drawer, piece, di, pi, prev: list[pi - 1], next: list[pi + 1], anthology, parts },
      });
    });
  });
  return out;
}
const { drawer, piece, di, pi, prev, next, anthology, parts } = Astro.props;
const stickers = (piece.stickers ?? drawer.stickers).slice(0, 4);
const sizes = [74, 60, 66, 54];
const pills = piece.tags ?? (piece.kicker ? [piece.kicker] : []);
const words = piece.body.join(" ").split(/\s+/).filter(Boolean).length;
const read = words >= 400 ? readTime(piece.body) : "";
// songs: a first line like "[chorus]" becomes a small heading
const sections = piece.body.map((b) => {
  const lines = b.split("\n");
  const m = /^\[(.+)\]$/.exec(lines[0]);
  return m ? { label: m[1], text: lines.slice(1).join("\n") } : { label: null, text: b };
});
const scrapFrames = ["dots", "kraft", "grid", "dots"];
const tapes = ["peri", "butter", "blush", "sage"];
const back = anthology ? { href: pieceHref(drawer, anthology), label: anthology.title } : drawer.tab ? { href: `/notebook#${drawer.tab}`, label: drawer.title } : { href: `/notebook/${drawer.slug}`, label: drawer.title };
const hasSheet = piece.stereo || piece.body.length > 0;
const lead = (piece.blurb ?? piece.body[0] ?? drawer.sub).replace(/^(#+|-)\s*/, "").replace(/\n- /g, "; ");
const desc = plain(lead).slice(0, 170);
const ext = (h) => /^https?:/.test(h);
---
<Layout page="notebook" title={`${plain(piece.title)} · ${drawer.title} · Shradha Lakshman`} description={desc}>
  <article class={`wrap page-section pc pc--${drawer.style}`}>
    <p class="pc-back"><a href={back.href}><svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M21 12H4M11 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg> {back.label}</a></p>

    <header class="pc-head">
      <p class="pc-meta keep-case">
        {pills.map((t) => <span class={`chip chip--${drawer.tone}`}>{t}</span>)}
        {piece.date && <span class="stamp" style="--r:-2deg">{piece.date}</span>}
        {read && <span class="stamp" style="--r:2deg;--stamp:var(--sage-deep)">{read}</span>}
        {(piece.stamps ?? []).map((t, k) => <span class="stamp" style={`--r:${k % 2 ? 3 : -2}deg;--stamp:#4a58ab`}>{t}</span>)}
        {piece.sample && <span class="stamp" style="--r:3deg;--stamp:#4a58ab">sample</span>}
        {piece.draft && <span class="stamp" style="--r:3deg;--stamp:#4a58ab">in the drafts</span>}
      </p>
      <SectionTitle text={piece.title} as="h1" start={di + pi + 1} class="pc-title" />
      {piece.note && <p class="pc-note hand scrap scrap--grid" set:html={inline(piece.note)} />}
    </header>

    {piece.noteBox && (
      <aside class="pc-box scrap scrap--dots" aria-label={piece.noteBox.title ?? "a note"}>
        <span class="tape tape--butter" style="top:-12px;left:12%;--r:-4deg"></span>
        {piece.noteBox.title && <h2 class="pc-box-h hand">{piece.noteBox.title}</h2>}
        {piece.noteBox.body.map((b) => <p class="hand" set:html={inline(b)} />)}
      </aside>
    )}

    {hasSheet && (
    <div class="pc-wrap">
      {stickers.map((s, k) => (
        <span class={`pc-st pc-st--${k + 1}`} aria-hidden="true"><Sticker name={s} size={sizes[k]} class="float" style={`--r0:${k % 2 ? -8 : 6}deg;--r1:${k % 2 ? 10 : -12}deg;--d:${5 + k}s`} /></span>
      ))}

      {drawer.style === "scraps" && !piece.stereo ? (
        <div class="pc-scraps">
          {sections.map((b, k) => {
            const blk = toBlocks([b.text])[0];
            return (
              <div class={`pc-scrap scrap scrap--${scrapFrames[(k + di) % 4]}${blk.t === "ul" ? " pc-scrap--list" : ""}`} style={`--rot:${[-2, 1.4, -0.8, 2][k % 4]}deg`}>
                <span class={`tape tape--${tapes[(k + 1) % 4]}`} style="top:-12px;left:42%;--r:3deg"></span>
                {blk.t === "ul" ? <ul class="pc-scrap-list">{blk.items.map((x) => <li set:html={x} />)}</ul> : <p set:html={inline(b.text)} />}
              </div>
            );
          })}
        </div>
      ) : (
        <div class={`pc-sheet scrap scrap--${drawer.frame}`}>
          <div class={`pc-plate pc-plate--${drawer.paper}`}>
            {piece.stereo ? (
              <div class="pc-body pc-body--stereo">
                <StereoPoem pairs={piece.stereo.pairs} translation={piece.stereo.translation} />
              </div>
            ) : (
              <div class={`pc-body pc-body--${drawer.style}${piece.look === "stream" ? " pc-body--stream" : ""}`}>
                {sections.map((b) => (
                  <section class="pc-blk">
                    {b.label && <h2 class="pc-sec keep-case">{b.label}</h2>}
                    {drawer.style === "marginalia" ? <p set:html={b.text.includes("==") ? inline(b.text) : `<span class="hl">${inline(b.text)}</span>`} />
                      : drawer.style === "lyrics" ? <p class="pc-lines">{b.text.split("\n").map((l) => <span class="pc-ln" set:html={inline(l)} />)}</p>
                      : <Blocks items={[b.text]} />}
                  </section>
                ))}
              </div>
            )}
            {piece.footnotes && piece.footnotes.length > 0 && (
              <aside class="pc-fn" aria-labelledby="pc-fn-h">
                <h2 id="pc-fn-h" class="pc-sec keep-case">footnotes</h2>
                <ol class="pc-fn-list">
                  {piece.footnotes.map((f, k) => (
                    <li id={`fn-${k + 1}`}><span set:html={inline(f)} />&nbsp;<a class="pc-fn-back" href={`#fnref-${k + 1}`} aria-label={`back to footnote ${k + 1} in the words`}>↩</a></li>
                  ))}
                </ol>
              </aside>
            )}
          </div>
        </div>
      )}
    </div>
    )}

    {parts.length > 0 && (
      <section class="pc-parts" aria-labelledby="pc-parts-h">
        <h2 id="pc-parts-h" class="hand pc-parts-h">inside</h2>
        <ul class="wl-grid wl-grid--stagger" role="list">
          {parts.map((p, n) => <WriteCard drawer={drawer} piece={p} n={n} i={di} tilt={[-3.2, 2.4, -1.8, 3, -2.4][n % 5]} href={pieceHref(drawer, p)} />)}
        </ul>
      </section>
    )}

    {piece.link && piece.link.style === "string" && (
      <div class="pc-link pc-link--string">
        {piece.link.aside && <p class="pc-aside hand">{piece.link.aside}</p>}
        <a class="pc-string" href={piece.link.href} {...(ext(piece.link.href) ? { target: "_blank", rel: "noopener" } : {})}>
          <Sticker name="music" size={40} class="pc-string-st" />
          <span class="pc-string-t">{piece.link.label}</span>
          <svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {ext(piece.link.href) && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </div>
    )}
    {piece.link && piece.link.style === "ticket" && (
      <div class="pc-link pc-link--ticket">
        {piece.link.aside && <p class="pc-aside hand">{piece.link.aside}</p>}
        <a class="pc-ticket" href={piece.link.href} {...(ext(piece.link.href) ? { target: "_blank", rel: "noopener" } : {})}>
          <span class="pc-ticket-stub" aria-hidden="true"><span class="pc-coin keep-case">25&cent;</span><span class="pc-ticket-no keep-case">admit one</span></span>
          <span class="pc-ticket-main">
            <span class="pc-ticket-t">{piece.link.label}</span>
            {piece.link.meta && <span class="pc-ticket-meta keep-case">{piece.link.meta}</span>}
          </span>
          <svg viewBox="0 0 24 24" width="1.3em" height="1.3em" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {ext(piece.link.href) && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      </div>
    )}
    {piece.link && !piece.link.style && (
      <p class="pc-link"><a class="btn" href={piece.link.href} {...(ext(piece.link.href) ? { target: "_blank", rel: "noopener" } : {})}>{piece.link.label}<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>{ext(piece.link.href) && <span class="sr-only"> (opens in a new tab)</span>}</a></p>
    )}

    {(prev || next) && (
      <nav class="pc-nav" aria-label={anthology ? `more from ${anthology.title}` : "more from this drawer"}>
        {prev ? <a class="pc-nav-a" href={pieceHref(drawer, prev)} rel="prev"><span>← before</span><strong>{prev.title}</strong></a> : <span></span>}
        {next ? <a class="pc-nav-a pc-nav-a--next" href={pieceHref(drawer, next)} rel="next"><span>next →</span><strong>{next.title}</strong></a> : <span></span>}
      </nav>
    )}
  </article>
</Layout>

<style is:global>
  .pc-back { margin: 0 0 1.2rem; font-size: 1.05rem; }
  .pc-back a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); text-underline-offset: 0.25em; }
  .pc-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.9rem 2rem; align-items: end; margin-bottom: 2.6rem; }
  .pc-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin: 0; }
  .pc-title { grid-column: 1; }
  .pc-note { grid-column: 2; margin: 0; max-width: 17rem; padding: 0.8rem 1.1rem 0.9rem; font-size: 1.45rem; line-height: 1.15; transform: rotate(3deg); --scrap-bg: #fdf9e9; }

  /* a longer note on the page, taped on like a post-it */
  .pc-box { position: relative; max-width: 46rem; margin: 0 auto 2.6rem; padding: 1.3rem 1.6rem 1.4rem; transform: rotate(-0.7deg); --scrap-bg: #fdf9e9; }
  .pc-box-h { margin: 0 0 0.4rem; font-size: 2.1rem; font-weight: 400; line-height: 1; }
  .pc-box p { margin: 0 0 0.6rem; font-size: 1.65rem; line-height: 1.12; }
  .pc-box p:last-child { margin-bottom: 0; }
  .pc-box em { font-style: normal; text-decoration: underline wavy var(--peri); text-underline-offset: 0.18em; }

  .pc-wrap { position: relative; max-width: 46rem; margin: 0 auto; }
  .pc-st { position: absolute; z-index: 3; pointer-events: none; }
  .pc-st--1 { top: -34px; right: 5%; }
  .pc-st--2 { top: 22%; left: -52px; }
  .pc-st--3 { bottom: -28px; right: 11%; }
  .pc-st--4 { bottom: 16%; left: -46px; }

  /* the sheet: patterned paper with the words pasted on top */
  .pc-sheet { padding: 0.8rem; color: #1f1b2e; }
  .pc-plate {
    --pad-y: clamp(1.5rem, 4vw, 2.7rem); --pad-x: clamp(1.2rem, 4.5vw, 3rem);
    position: relative; padding: var(--pad-y) var(--pad-x); color: #1f1b2e; background-color: #fffdf3; border: 2px solid #1f1b2e;
  }
  .pc-plate--ruled {
    background-image: linear-gradient(90deg, transparent 2rem, rgba(228, 87, 61, 0.5) 2rem calc(2rem + 2px), transparent calc(2rem + 2px)),
      repeating-linear-gradient(to bottom, transparent 0 calc(2rem - 1px), rgba(74, 88, 171, 0.28) calc(2rem - 1px) 2rem);
    background-position: 0 0, 0 var(--pad-y); padding-left: calc(var(--pad-x) + 1.4rem);
  }
  .pc-plate--grid {
    background-image: linear-gradient(rgba(74, 88, 171, 0.22) 1px, transparent 1px), linear-gradient(90deg, rgba(74, 88, 171, 0.22) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem; background-position: 0 var(--pad-y), 0 0;
  }
  .pc-plate--gingham {
    background-image: linear-gradient(rgba(255, 253, 243, 0.84), rgba(255, 253, 243, 0.84)), linear-gradient(rgba(79, 115, 84, 0.45) 50%, transparent 50%), linear-gradient(90deg, rgba(79, 115, 84, 0.45) 50%, transparent 50%);
    background-size: auto, 30px 30px, 30px 30px;
  }
  /* soft butter paper: a faint wavy grid and a few pale stars in the margins. kept low-contrast so the words stay easy to read. */
  .pc-plate--butter {
    --star: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Cpolygon points=%2250,12 60,38 88,39 66,57 74,84 50,68 26,84 34,57 12,39 40,38%22 fill=%22%23f6e08e%22 stroke=%22%23f6e08e%22 stroke-width=%229%22 stroke-linejoin=%22round%22 opacity=%22.85%22/%3E%3C/svg%3E");
    background-color: #fbf0c4;
