---
// explore.astro  ·  featured work, field notes, and the full archive of projects.
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import HandArrow from "../components/HandArrow.astro";
import Sticker from "../components/Sticker.astro";
import { projects, getProject } from "../data/projects";

const eureka = getProject("eureka-questscapes")!;
const adea = getProject("adea-fellowship")!;

// short entries from the field: only facts from the cv. swap in your own write-ups as they get written.
const notes = [
  { when: "may 2025", where: "Northern BC", tag: "outreach", title: "the travelling roadshow", body: "interactive oral-health workshops for students in grades 4–12, as the dental hygiene representative. the oral-systemic link, and hygiene as a primary care profession.", href: "/projects/roadshow", paper: "kraft", st: "butterfly" },
  { when: "may–aug 2025", where: "UBC Health", tag: "curriculum", title: "making curricula legible", body: "an accessibility audit and revision of materials used by 2,000+ learners across 14 health programs, plus a simplified, icon-based competency framework.", href: "/projects/che-project", paper: "newsprint", st: "heart" },
  { when: "ADEA academic dental careers fellowship", where: "", tag: "teaching", title: "learning to teach", body: "co-facilitating motivational interviewing instruction and interprofessional orientation, and evaluating how novice educators actually develop.", href: "/projects/adea-fellowship", paper: "ruled", st: "sparkle" },
  { when: "jan 2024–apr 2026", where: "Vancouver", tag: "community", title: "community placements", body: "oral-health assessments and education with Union Gospel Mission, Pioneer Community Living Association, and the Elizabeth Fry Society; free oral-cancer screenings.", paper: "gingham", st: "tooth" },
  { when: "UBC Faculty of Dentistry", where: "", tag: "mentoring", title: "peer mentor + panelist", body: "mentored 53 junior students on study strategies and academic readiness, and sat on the year 2 and year 3 mentorship panels.", paper: "butter", st: "star" },
  { when: "Pacific Dental Conference", where: "", tag: "advocacy", title: "the disability + oral health booth", body: "representing the Canadian Society for Disability and Oral Health, sharing accessibility and disability-inclusive care strategies.", paper: "grid", st: "eye" },
];
const tones = ["peri", "butter", "sage", "blush"];
---
<Layout page="explore" title="explore · Shradha Lakshman" description="featured projects, field notes, and the archive of what Shradha Lakshman has been working on.">
  <div class="wrap page-section">
    <SectionTitle text="explore" start={1} />

    <!-- featured -->
    <section aria-labelledby="feat-h" class="ex-feat">
      <h2 id="feat-h" class="ex-h"><span class="hand">featured</span></h2>
      <div class="ex-feat-grid">
        <a class="feat scrap scrap--floral" style="--r:-1.1deg" href={`/projects/${eureka.slug}`} data-reveal>
          <span class="tape tape--butter" style="top:-13px;left:12%;--r:-5deg"></span>
          <Sticker name="tooth" size={76} class="feat-s" />
          <span class="feat-card">
            <span class="chip chip--butter keep-case">{eureka.year} · {eureka.place}</span>
            <span class="feat-title">eureka: questscapes <em>+ the research behind it</em></span>
            <span class="feat-body">a gamified, web-based hiv education platform for youth that weaves sexual-health and oral-health literacy together. it grew out of a rapid scoping review of digital hiv interventions; $2,000+ in seed funding and awards so far.</span>
            <span class="feat-go">read the story <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </span>
        </a>
        <a class="feat scrap scrap--grid" style="--r:1deg" href={`/projects/${adea.slug}`} data-reveal data-delay="150">
          <span class="tape tape--blush" style="top:-13px;right:12%;--r:5deg"></span>
          <Sticker name="sparkle" size={70} class="feat-s feat-s--r" />
          <span class="feat-card">
            <span class="chip chip--peri keep-case">Canadian Oral Health Summit</span>
            <span class="feat-title">ADEA poster <em>+ oral presentation</em></span>
            <span class="feat-body">an evaluation of a dental fellowship that follows how novice educators develop through delivering preclinical curriculum, presented as a poster and an oral presentation.</span>
            <span class="feat-go">read the story <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          </span>
        </a>
      </div>
    </section>

    <!-- field notes -->
    <section aria-labelledby="fn-h" class="ex-notes">
      <h2 id="fn-h" class="ex-h"><span class="hand">field notes</span> <HandArrow shape="wave" size={46} /></h2>
      <ul class="fn-grid">
        {notes.map((n, i) => (
          <li class="fn" style={`--tilt:${[-1.6, 1.2, -0.8, 1.7, -1.3, 0.9][i]}deg`} data-reveal data-delay={i * 70}>
            <span class={`tape tape--${tones[i % 4]}`} style="top:-12px;left:50%;margin-left:-48px;--r:-3deg"></span>
            <article class={`fn-card paper--${n.paper}`}>
              <div class="fn-in">
                <p class="fn-meta keep-case"><span>{n.when}</span>{n.where && <span> · {n.where}</span>}</p>
                <h3>{n.href ? <a href={n.href}>{n.title}</a> : n.title}</h3>
                <p>{n.body}</p>
                <span class={`chip chip--${tones[(i + 1) % 4]}`}>{n.tag}</span>
              </div>
              <Sticker name={n.st} size={44} class="fn-s" />
            </article>
          </li>
        ))}
      </ul>
    </section>

    <!-- archive -->
    <section aria-labelledby="ar-h" class="ex-archive">
      <h2 id="ar-h" class="ex-h"><span class="hand">the archive</span></h2>
      <ol class="ar-list scrap scrap--kraft">
        {projects.map((p, i) => (
          <li>
            <a href={`/projects/${p.slug}`}>
              <span class="ar-no keep-case">{String(i + 1).padStart(2, "0")}</span>
              <span class="ar-title">{p.title}</span>
              <span class="ar-meta keep-case">{[p.year, p.place].filter(Boolean).join(" · ")}</span>
              <svg class="ar-arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </li>
        ))}
      </ol>
      <p class="ex-more">
        <a class="cta cta--right" href="/experience"><span>the full cv lives here</span><svg class="cta-arrow" viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a class="cta cta--right" href="/notebook"><span>the notebook has the odder stuff</span><svg class="cta-arrow" viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </p>
    </section>
  </div>
</Layout>

<style is:global>
  .ex-feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 2.6rem 2.2rem; }
  .feat { display: block; padding: clamp(1.3rem, 3vw, 2rem); color: var(--ink); text-decoration: none; transform: rotate(var(--r)); transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .feat:hover, .feat:focus-visible { transform: rotate(0deg) translateY(-6px) scale(1.015); }
  .feat-card { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; padding: 1.2rem 1.3rem 1.3rem; background: color-mix(in srgb, var(--paper) 94%, transparent); border: 2px solid var(--ink); border-radius: 4px; box-shadow: 4px 4px 0 var(--ink); }
  .feat-s { position: absolute; right: -6px; top: -30px; z-index: 2; transform: rotate(10deg); }
  .feat-s--r { right: auto; left: -8px; top: -34px; transform: rotate(-12deg); }
  .feat-title { font: 600 clamp(1.6rem, 3vw, 2.2rem)/1.05 var(--f-display); letter-spacing: -0.02em; }
  .feat-title em { font-weight: 500; }
  .feat-body { font-size: 1.05rem; line-height: 1.5; }
  .feat-go { display: inline-flex; align-items: center; gap: 0.4rem; font: italic 600 1.15rem/1 var(--f-display); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--peri); }
  .feat:hover .feat-go svg { transform: translateX(6px); }
  .feat-go svg { transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }

  .fn-grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 2.4rem 1.8rem; }
  .fn { position: relative; transform: rotate(var(--tilt)); transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .fn:hover { transform: rotate(0deg) translateY(-5px); }
  .fn-card { position: relative; height: 100%; border: 2px solid var(--ink); border-radius: 3px; box-shadow: 4px 5px 0 var(--shadow); color: #1f1b2e; }
  .fn-in { height: 100%; margin: 0.6rem; padding: 0.9rem 1rem 1rem; background: rgba(255, 253, 243, 0.9); border-radius: 2px; }
  .fn-meta { margin: 0 0 0.35rem; font: 400 0.76rem/1.3 var(--f-type); color: #4c4666; }
  .fn h3 { font-size: 1.35rem; margin-bottom: 0.4rem; }
  .fn h3 a { color: inherit; text-decoration-color: var(--peri-deep); }
  .fn p:not(.fn-meta) { font-size: 1rem; line-height: 1.45; margin-bottom: 0.7rem; color: #1f1b2e; }
  .fn-s { position: absolute; right: -10px; bottom: -14px; transform: rotate(8deg); }

  .ar-list { list-style: none; padding: 0.6rem 0.4rem; --scrap-bg: var(--paper); }
  .ar-list a { display: grid; grid-template-columns: 3rem 1fr auto 28px; align-items: baseline; gap: 0.2rem 1rem; padding: 0.85rem 1rem; color: var(--ink); text-decoration: none; border-bottom: 2px dashed color-mix(in srgb, var(--ink) 30%, transparent); transition: background 0.25s, padding 0.3s; }
  .ar-list li:last-child a { border-bottom: 0; }
  .ar-list a:hover, .ar-list a:focus-visible { background: color-mix(in srgb, var(--butter) 40%, transparent); padding-left: 1.5rem; }
  .ar-no { font: 400 0.9rem/1 var(--f-type); color: var(--ink-soft); }
  .ar-title { font: 600 clamp(1.15rem, 2.4vw, 1.5rem)/1.15 var(--f-display); letter-spacing: -0.01em; }
  .ar-meta { font: 400 0.78rem/1.2 var(--f-type); color: var(--ink-soft); }
  .ar-arrow { align-self: center; transition: transform 0.3s; }
  .ar-list a:hover .ar-arrow { transform: translateX(5px); }
  .ex-more { display: flex; flex-wrap: wrap; gap: 0.8rem 2.4rem; margin-top: 2rem; }
  @media (max-width: 640px) {
    .ar-list a { grid-template-columns: 2.2rem 1fr 24px; }
    .ar-meta { grid-column: 2; grid-row: 2; }
    .ar-arrow { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
