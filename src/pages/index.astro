---
// index.astro  ·  home: the big tooth, the typed hello, the polaroids.
import Layout from "../layouts/Layout.astro";
import Sticker from "../components/Sticker.astro";
import HandArrow from "../components/HandArrow.astro";
import Polaroid from "../components/Polaroid.astro";
import Burst from "../components/Burst.astro";
import Eyes from "../components/Eyes.astro";
import { projects } from "../data/projects";
---
<Layout page="home" title="Shradha Lakshman · dental hygienist, health educator, curious human">
  <!-- 1 · hero: just the tooth, turning in place. scroll and it flies up into the nav. -->
  <section class="hero" aria-label="welcome">
    <div class="hero-stage" aria-hidden="true">
      <!-- a soft dark veil over the decorations, under the tooth, the "no. 26" label, and the stamp, so those three read first -->
      <span class="hero-veil"></span>
      <Burst size={700} points={16} inner={0.82} fill="floral" class="hero-burst" />
      <span class="hero-scrap hero-scrap--a scrap scrap--floral"></span>
      <span class="hero-scrap hero-scrap--b scrap scrap--news"></span>
      <Eyes size={132} class="hero-eyes float" />
      <Sticker name="ghost" size={74} class="hero-s hero-ghost float" />
      <Sticker name="star-paper" size={58} class="hero-s hero-star float" />
      <Sticker name="sparkle" size={52} class="hero-s hero-sparkle float" />
      <Sticker name="butterfly" size={70} class="hero-s hero-bfly float" />
      <Sticker name="moon" size={50} class="hero-s hero-moon float" />
      <p class="hero-label scrap scrap--dots keep-case"><span class="tape tape--blush" style="top:-15px;right:22px;--r:5deg"></span>no. 26 · upper left first molar</p>
      <p class="hero-note hand scrap scrap--grid">
        <span>the little extra bump? that's the cusp of Carabelli.</span>
      </p>
      <!-- sits in the stage (not inside the note) so its tip is placed from the tooth's own size and position -->
      <span class="hero-arrow" aria-hidden="true"><HandArrow shape="arc" size={190} class="hero-note-arrow" /></span>
      <span class="stamp hero-stamp keep-case">bdsc dental hygiene · UBC · 2026</span>
    </div>
    <p class="sr-only">an illustration of tooth number 26, an upper left first molar, slowly turning on a floral paper burst. the small extra bump on its upper left corner is the cusp of Carabelli. bdsc dental hygiene, UBC, 2026.</p>
    <p class="hero-scroll hand" aria-hidden="true"><span>scroll</span><HandArrow shape="spiral" size={46} /></p>
  </section>

  <!-- 2 · the hello -->
  <section class="intro wrap" aria-labelledby="hello">
    <h1 id="hello" class="sr-only">hi, my name is Shradha Lakshman</h1>
    <div class="intro-type" data-typewriter aria-hidden="true">
      <span class="tw-greet"><span class="tw-text" lang="en">hi, my name is</span><span class="tw-cursor"></span></span>
      <span class="tw-name">Shradha<br class="tw-br" /> Lakshman</span>
      <svg class="tw-underline" data-reveal viewBox="0 0 520 26" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 16C60 6 120 22 190 12S330 4 400 14S490 18 516 8" /></svg>
    </div>
    <p class="tagline"><span class="hl">a seeker of knowledge, perspective, and possibility.</span></p>
    <a class="cta cta--down" href="#up-to">
      <span>see what i've been up to</span>
      <svg class="cta-arrow" viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M12 3v17M5 13l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </section>

  <!-- 3 · the polaroids -->
  <section id="up-to" class="gallery wrap" aria-labelledby="gal-h">
    <h2 id="gal-h" class="sr-only">what i've been up to</h2>
    <div class="pols">
      {projects.map((p, i) => <Polaroid project={p} index={i} />)}
    </div>
    <Sticker name="flower" size={64} class="gal-s gal-s--a float" />
    <Sticker name="fish" size={78} class="gal-s gal-s--b float" />
  </section>

  <!-- 4 · on to the archives -->
  <section class="archives wrap">
    <a class="cta cta--big cta--right" href="/explore">
      <span>intrigued? take a deep dive into the archives</span>
      <svg class="cta-arrow" viewBox="0 0 24 24" width="1.1em" height="1.1em" aria-hidden="true"><path d="M3 12h17M13 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </a>
  </section>
</Layout>

<style is:global>
  /* ── hero ── */
  .hero { position: relative; height: calc(100svh - var(--note-h, 0px)); min-height: 560px; }
  .hero-stage { --bsc: min(96vw, 700px); position: absolute; inset: 0; overflow: hidden; opacity: calc(1 - var(--p) * 2.4); }
  .hero-burst { left: 50%; top: calc(50svh - 2.25rem + 4px); width: var(--bsc); height: var(--bsc); transform: translate(-50%, -50%); }
  .hero-burst.burst--spin { animation-name: burst-spin-c; }
  @keyframes burst-spin-c { from { transform: translate(-50%, -50%) rotate(0); } to { transform: translate(-50%, -50%) rotate(360deg); } }
  .hero-scrap { position: absolute; display: block; }
  .hero-scrap--a { left: -6%; top: 68%; width: 24%; height: 14%; --scrap-bg: var(--tile-floral); transform: rotate(-6deg); }
  .hero-scrap--b { right: -5%; bottom: 20%; width: 22%; height: 16%; transform: rotate(7deg); }
  .hero-s { position: absolute; }
  .hero-eyes { position: absolute; right: 12%; top: 20%; }
  .hero-ghost { left: 12%; bottom: 22%; --r0: -8deg; --r1: 6deg; }
  .hero-star { left: 22%; top: 12%; --r0: 0deg; --r1: 40deg; }
  .hero-sparkle { right: 22%; bottom: 14%; --r0: -10deg; --r1: 18deg; }
  .hero-bfly { right: 7%; top: 46%; --r0: 8deg; --r1: -10deg; }
  .hero-moon { left: 8%; top: 52%; --r0: -12deg; --r1: 10deg; }
  /* visual hierarchy: everything in the hero is dimmed except the tooth (a separate layer above), the label, and the stamp */
  .hero-veil { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(to bottom, rgba(31, 27, 46, 0.27) 0%, rgba(31, 27, 46, 0.27) 80%, rgba(31, 27, 46, 0) 100%); }
  :root[data-theme="dark"] .hero-veil { background: linear-gradient(to bottom, rgba(0, 0, 0, 0.36) 0%, rgba(0, 0, 0, 0.36) 80%, rgba(0, 0, 0, 0) 100%); }
  :root[data-a11y="on"] .hero-veil { display: none; }
  .hero-label, .hero-note, .hero-arrow { z-index: 2; }
  .hero-stamp { z-index: 2; background: #fffdf3; box-shadow: 2px 3px 0 rgba(31, 27, 46, 0.3); }
  :root[data-theme="dark"] .hero-stamp { background: var(--paper); box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.45); }
  /* the scroll hint sits on its own little paper pill, above everything, so the spinning burst can never wash it out */
  html.js .hero-scroll .hand-arrow path { stroke-dashoffset: 0; }
  .hero-scroll { z-index: 3; padding: 0.05rem 0.85rem 0.1rem; background: var(--paper); border: 2px solid var(--ink); border-radius: 99px; }
  .hero-label {
    position: absolute; left: 50%; top: calc(50svh - 2.25rem + 4px + var(--tw) * 0.5 + 0.9rem); margin: 0; padding: 1.05rem 1.2rem 0.6rem;
    font: 400 0.92rem/1.1 var(--f-type); letter-spacing: 0.03em; transform: translateX(-50%) rotate(-1.6deg); white-space: nowrap;
  }
  .hero-note {
    position: absolute; left: clamp(1rem, 5.5vw, 6.5rem); top: calc(50svh - 2.25rem - var(--tw) * 0.56); margin: 0; width: 14.5rem; padding: 0.7rem 1rem 0.8rem;
    font-size: 1.45rem; line-height: 1.15; transform: rotate(-3.5deg);
  }
  /* the arrow's tip is placed from the tooth itself: its box is --tw wide, centred, and the cusp of carabelli sits at about (24, 44) of 220 (its upper-left edge, resting pose).
     it only means something while the tooth rests in the hero facing front, so it fades as soon as you scroll (tooth.ts) and while the tooth turns away (same 15s loop as the tooth) */
  .hero-arrow {
    --tip-x: calc(50% - 0.391 * var(--tw));
    --tip-y: calc(2px + max(1.5rem, (100svh - var(--tw)) / 2 - 2.25rem) + 0.2 * var(--tw));
    --aw: clamp(70px, calc((50vw - 0.391 * var(--tw) - clamp(1rem, 5.5vw, 6.5rem) - 14.5rem + 1.6rem) / 0.773), 200px);
    position: absolute; left: var(--tip-x); top: var(--tip-y); width: var(--aw); line-height: 0;
    transform-origin: 77.3% 89.5%; transform: translate(-77.3%, -89.5%) rotate(-8deg);
  }
  .hero-note-arrow { display: block; width: 100%; height: auto; animation: arrow-rest 15s linear var(--ad, 0s) infinite; }
  @keyframes arrow-rest { 0%, 30% { opacity: 1; } 40%, 77% { opacity: 0; } 86%, 100% { opacity: 1; } }
  :root[data-motion="off"] .hero-note-arrow { animation: none; }
  @media (prefers-reduced-motion: reduce) { :root:not([data-motion="on"]) .hero-note-arrow { animation: none; } }
  .hero-note-arrow path { stroke-width: 1.7; }
  .hero-stamp { position: absolute; right: 7%; top: 14%; --stamp: var(--peri-deep); --r: 7deg; }
  .hero-scroll { position: absolute; left: 50%; bottom: 2.2rem; transform: translateX(-50%); margin: 0; display: flex; align-items: flex-end; gap: 0.3rem; font-size: 1.9rem; opacity: calc(1 - var(--p) * 3); animation: nudge 2.2s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translate(-50%, 8px); } }
  .hero-eyes.float { --r0: -3deg; --r1: 3deg; --d: 5s; }

  /* ── the hello ── */
  .intro { position: relative; text-align: center; padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem); opacity: calc((var(--p) - 0.32) * 1.9); }
  .intro-type { position: relative; display: inline-flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .tw-greet { display: inline-flex; align-items: center; min-height: 2.6rem; font: 400 clamp(1.3rem, 3.4vw, 2rem)/1.2 var(--f-type); color: var(--ink-soft); }
  .tw-text { white-space: pre; }
  .tw-cursor { display: inline-block; width: 0.12em; height: 1.15em; margin-left: 0.18em; background: var(--ink); animation: blink 0.95s steps(1) infinite; }
  .intro-type:not(.is-resting) .tw-cursor { animation: none; }
  .intro-type.is-static .tw-cursor { display: none; }
  @keyframes blink { 50% { opacity: 0; } }
  .tw-name { font: 600 italic clamp(3.1rem, 11.5vw, 8.6rem)/0.92 var(--f-display); letter-spacing: -0.035em; }
  .tw-br { display: none; }
  .tw-underline { width: min(100%, 520px); height: 22px; margin-top: 0.2rem; overflow: visible; }
  .tw-underline path { fill: none; stroke: var(--peri-deep); stroke-width: 4.5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.3s cubic-bezier(0.5, 0.1, 0.3, 1) 0.3s; }
  html.js .tw-underline:not(.is-in) path { stroke-dashoffset: 1; }
  .tagline { margin: 1.6rem auto 1.7rem; max-width: 30ch; font: italic 400 clamp(1.35rem, 3vw, 1.85rem)/1.35 var(--f-body); }

  /* ── polaroids ── */
  .gallery { position: relative; padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem); }
  .pols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3.2rem 1.4rem; align-items: start; }
  .gal-s { position: absolute; }
  .gal-s--a { left: -2%; top: 46%; --r0: -6deg; --r1: 12deg; }
  .gal-s--b { right: -3%; top: 10%; --r0: 4deg; --r1: -8deg; --d: 7.5s; }
  .archives { padding: clamp(2.5rem, 6vw, 4.5rem) 0 1rem; text-align: center; }

  @media (max-width: 1040px) { .pols { grid-template-columns: repeat(2, 1fr); gap: 3rem 1.2rem; } .gal-s { display: none; } }
  @media (max-width: 760px) {
    .hero-eyes { right: 6%; top: 15%; width: 96px; height: auto; }
    .hero-stamp { display: none; }
    .hero-note { left: 0.9rem; top: max(5.4rem, calc(50svh - 2.25rem - var(--bsc) * 0.5 - 5.2rem)); width: 12.2rem; font-size: 1.22rem; padding: 0.5rem 0.8rem 0.6rem; }
    .hero-arrow { --aw: clamp(58px, calc((var(--tip-y) - 5.4rem - 5.2rem - 0.2 * var(--tw)) * 1.3), 150px); transform: translate(-77.3%, -89.5%) rotate(-6deg); }
    .hero-note-arrow path { stroke-width: 2.4; }
    .hero-star { display: none; }
    .hero-label { font-size: 0.78rem; }
    .hero-scrap--a, .hero-scrap--b { display: none; }
    .tw-br { display: inline; }
    .tw-name { font-size: clamp(3.4rem, 17vw, 5.2rem); }
  }
  @media (max-width: 760px) and (max-height: 640px) { .hero-note { width: 11.4rem; font-size: 1.08rem; } }
  @media (max-width: 520px) {
    .pols { grid-template-columns: 1fr; gap: 3rem; }
    .pol:nth-child(even) .pol-card, .pol:nth-child(odd) .pol-card { width: min(100%, 290px); }
    .pol:nth-child(even) { align-self: flex-end; }
    .hero-ghost, .hero-moon { display: none; }
  }
</style>
